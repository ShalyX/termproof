# Production planner credentials. Keep both server-side deployment secrets.
# Gemini is primary; DeepSeek is used only for bounded Gemini operational failures.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional; increases GitHub REST API rate limits for public repository checks.
GITHUB_TOKEN=

# Required in production. Server-side Postgres connection string for the dedicated Termproof database.
TERMPROOF_DATABASE_URL=
TERMPROOF_DB_POOL_MAX=4

# Durable verification API rate limit.
VERIFY_RATE_LIMIT_MAX=30
VERIFY_RATE_LIMIT_WINDOW_MS=60000
